# Safe production configuration example. Do not store the real file in Git.
NODE_ENV=production
HOST=127.0.0.1
PORT=3100
TELEMETRY_API_BASE_URL=http://10.0.1.157:5080
TELEMETRY_API_TIMEOUT_MS=5000
PLANT_TIME_ZONE=America/Chicago
RADIUS_STALE_SECONDS=180

# Radius remains disabled unless every setting below is present. Values must come
# from live schema/mapping discovery and a dedicated SELECT-only login.
# RADIUS_DB_HOST=127.0.0.1
# RADIUS_DB_PORT=5432
# RADIUS_DB_NAME=press_radius_db
# RADIUS_DB_USER=processintelligence_readonly
# RADIUS_DB_PASSWORD=<dedicated-read-only-password>
# RADIUS_DB_SCHEMA=public
# RADIUS_DB_TABLE=machine_status_history
# RADIUS_DB_TIMESTAMP_MODE=timestamptz

# Optional, separate writable ProcessIntelligence application store. This must
# never point at press_radius_db or the telemetry historian. Provision the
# processintelligence_db database and restricted processintelligence_app role,
# then apply server/migrations to that database before enabling these values.
# APP_DB_HOST=127.0.0.1
# APP_DB_PORT=5432
# APP_DB_NAME=processintelligence_db
# APP_DB_USER=processintelligence_app
# APP_DB_PASSWORD=<dedicated-application-password>
# RADIUS_RUN_PRODUCTION_STATUS=Run Production
# RADIUS_PRESS_MAPPINGS=press3:203,press5:205,press6:206,press7:207,press8:208,press9:209,press10:210,press11:211,press12:212,press13:213,press14:214,press15:215
